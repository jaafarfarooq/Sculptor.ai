{
  "name": "rahim/chat-bot",
  "description": "Fitness chat-bot using OpenAI",
  "require": {
    "vlucas/phpdotenv": "^5.5"
  },
  "require-dev": {
    "phpunit/phpunit": "^9"
  },
  "autoload": {
    "psr-4": {
      "App\\Controller\\": "src/Controller/",
      "App\\Service\\":    "src/Service/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Tests\\Controller\\": "tests/Controller/",
      "App\\Tests\\ervice\\":     "tests/Service/"
    }
  },
  "scripts": {
    "test": "phpunit --colors=always"
  }
}
